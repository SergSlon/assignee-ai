{
  "name": "@assignee/cli",
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "version": "0.1.0",
  "description": "Assignee.ai CLI — plan, estimate, and provision AWS infrastructure from natural language with HITL approval, best-practice auto-fix, and pre-apply cost preflight.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "assignee": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.*",
    "!dist/__tests__/**",
    "!dist/**/__tests__/**",
    "!dist/test-harness/**",
    "!dist/test-setup.*",
    "!dist/e2e/**",
    "!dist/services/__tests__/**",
    "!dist/**/test-fixtures/**",
    "completions",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SergSlon/assignee-ai.git",
    "directory": "apps/cli"
  },
  "homepage": "https://assignee.ai",
  "bugs": {
    "url": "https://github.com/SergSlon/assignee-ai/issues"
  },
  "keywords": [
    "assignee",
    "cloud",
    "infrastructure",
    "aws",
    "iac",
    "ai",
    "cli",
    "devops",
    "cloud-operator",
    "natural-language"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "chmod +x dist/index.js && npx tsx scripts/generate-completions.ts",
    "dev": "tsc --watch",
    "generate-completions": "npx tsx scripts/generate-completions.ts",
    "prepublishOnly": "cd ../.. && npx turbo build --filter=@assignee/cli",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "RUN_E2E=1 vitest run --pool=forks --poolOptions.forks.singleFork=true 'src/e2e/e2e-plan-*.test.ts'",
    "pre-close-probes": "bash scripts/pre-close-probes.sh",
    "start": "node ./dist/index.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.108",
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/google": "^3.0.79",
    "@ai-sdk/openai": "^3.0.65",
    "@assignee/best-practices": "workspace:*",
    "@assignee/core": "workspace:*",
    "@aws-sdk/client-bedrock": "^3.1051.0",
    "@aws-sdk/client-cloudcontrol": "^3.1051.0",
    "@aws-sdk/client-cloudfront": "^3.1051.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1051.0",
    "@aws-sdk/client-dynamodb": "^3.1051.0",
    "@aws-sdk/client-ec2": "^3.1051.0",
    "@aws-sdk/client-ecr": "^3.1051.0",
    "@aws-sdk/client-ecs": "^3.1051.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "^3.1051.0",
    "@aws-sdk/client-eventbridge": "^3.1051.0",
    "@aws-sdk/client-iam": "^3.1051.0",
    "@aws-sdk/client-kms": "^3.1051.0",
    "@aws-sdk/client-lambda": "^3.1051.0",
    "@aws-sdk/client-rds": "^3.1051.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1051.0",
    "@aws-sdk/client-s3": "^3.1051.0",
    "@aws-sdk/client-secrets-manager": "^3.1051.0",
    "@aws-sdk/client-sns": "^3.1051.0",
    "@aws-sdk/client-ssm": "^3.1051.0",
    "@aws-sdk/client-sts": "^3.1051.0",
    "@aws-sdk/credential-providers": "^3.1051.0",
    "@clack/prompts": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/mcp-adapters": "^1.1.3",
    "ai": "^6.0.188",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "update-notifier": "^7.3.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@assignee/eslint-config": "workspace:*",
    "@assignee/tsconfig": "workspace:*",
    "@aws-sdk/client-efs": "^3.1051.0",
    "@types/node": "^25.9.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2",
    "vitest": "^3.1.0"
  }
}
