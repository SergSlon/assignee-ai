# Assignee.ai — environment variables
# Copy to .env and fill in real values. Never commit .env.
# Run `assignee setup` to auto-generate IAM users and credentials.

# ── Operator (assignee-operator) ─────────────────────────────────────────────
# Used directly by the CLI for Amazon Bedrock + CloudControl provisioning.
# Highest privilege — scoped to Bedrock invoke and supported resource types.
ASSIGNEE_OPERATOR_ACCESS_KEY_ID=AKIA...
ASSIGNEE_OPERATOR_SECRET_ACCESS_KEY=...
# Optional: STS / federated session token for the operator user.
# ASSIGNEE_OPERATOR_SESSION_TOKEN=
AWS_REGION=us-east-1
# Optional AWS SDK-standard fallbacks (only used when the ASSIGNEE_* blocks
# above are empty). Most users leave these commented.
# AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ── Reader (assignee-reader) ─────────────────────────────────────────────────
# Passed to MCP server subprocesses that need schema, pricing, and billing data.
# Read-only: CloudFormation schema, Pricing API, Cost Explorer.
ASSIGNEE_READER_ACCESS_KEY_ID=AKIA...
ASSIGNEE_READER_SECRET_ACCESS_KEY=...

# ── Auditor (assignee-auditor) ───────────────────────────────────────────────
# Passed to MCP server subprocesses that assess security posture.
# Read-only: IAM simulate, SecurityHub, GuardDuty, Inspector, Access Analyzer.
ASSIGNEE_AUDITOR_ACCESS_KEY_ID=AKIA...
ASSIGNEE_AUDITOR_SECRET_ACCESS_KEY=...

# ── LLM model (optional override) ─────────────────────────────────────────────
# Format: "provider/model-id". Defaults to bedrock/amazon.nova-lite-v1:0.
# Supported providers: bedrock, anthropic, openai, google, ollama.
# ASSIGNEE_LLM_DEFAULT=bedrock/amazon.nova-lite-v1:0
# ASSIGNEE_LLM_DEFAULT=anthropic/claude-sonnet-4-5
#
# DEPRECATED: ASSIGNEE_MODEL still works as a fallback but prefer
# ASSIGNEE_LLM_DEFAULT for consistency with per-node ASSIGNEE_LLM_* vars.
# ASSIGNEE_MODEL=bedrock/amazon.nova-lite-v1:0  # deprecated

# ── Non-Bedrock provider API keys ─────────────────────────────────────────────
# Required only when ASSIGNEE_LLM_DEFAULT points at a non-Bedrock provider.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ── Per-node LLM routing (Story 44.1) ────────────────────────────────────────
# Override the model for specific pipeline nodes. Each node can use a different
# provider/model. Unset nodes fall back to ASSIGNEE_LLM_DEFAULT (above).
#
# Approximate pricing (per 1M tokens, on-demand, us-east-1). Prices change —
# verify at the provider's pricing page before committing to a config:
#   Bedrock:    https://aws.amazon.com/bedrock/pricing/
#   Anthropic:  https://docs.anthropic.com/en/docs/about-claude/pricing
#   OpenAI:     https://openai.com/api/pricing/
#
#   Nova Micro:      ~$0.018 input / ~$0.070 output  — fastest, cheapest (classification)
#   Nova Lite:       ~$0.030 input / ~$0.120 output  — good balance (DEFAULT for all nodes)
#   Nova Pro:        ~$0.400 input / ~$1.600 output  — complex reasoning
#   Nova Premier:    ~$2.500 input / ~$12.50 output  — frontier Nova
#   DeepSeek V3.1:   ~$0.580 input / ~$1.680 output  — smart + cheap (Bedrock)
#   Claude 3 Haiku:  ~$0.250 input / ~$1.250 output  — fast (Bedrock, older)
#   Haiku 4.5:       ~$1.000 input / ~$5.000 output  — fast + affordable (Anthropic API)
#   Sonnet 4.6:      ~$3.000 input / ~$15.00 output  — best quality (Anthropic API)
#
# Recommended config (optimized for price/quality per node):
#   intent_parser       → Nova Micro  (classification — 40% cheaper than Lite)
#   plan_generator      → Sonnet 4.6  (accurate CFN JSON — reduces repair-node calls)
#   advice_generator    → Nova Lite   (prose hints — default is fine)
#   workload_classifier → Nova Micro  (classification — 40% cheaper than Lite)
#
# ASSIGNEE_LLM_DEFAULT=bedrock/amazon.nova-lite-v1:0
# ASSIGNEE_LLM_PLAN_GENERATOR=anthropic/claude-sonnet-4-6
# ASSIGNEE_LLM_INTENT_PARSER=bedrock/amazon.nova-micro-v1:0
# ASSIGNEE_LLM_ADVICE_GENERATOR=bedrock/amazon.nova-lite-v1:0
# ASSIGNEE_LLM_WORKLOAD_CLASSIFIER=bedrock/amazon.nova-micro-v1:0

# ── Bedrock Guardrail (optional) ──────────────────────────────────────────────
# Applies to all bedrock/ models. Suppresses guardrail_disabled warning in logs.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=

# ── Global preferences (override via env) ────────────────────────────────────
# These override the same keys in .assignee/config.yaml and ~/.config/assignee/config.yaml.
# ASSIGNEE_AUTO_FIX=ask          # ask | apply | skip
# ASSIGNEE_OUTPUT_FORMAT=table   # table | json
# ASSIGNEE_DEFAULT_REGION=us-east-1
# ASSIGNEE_DEFAULT_TAGS=env=dev,team=platform

# ── Best-practices manifest integrity ─────────────────────────────────────────
# enforce  → manifest must verify or the CLI aborts (default in production)
# warn     → verification failures only emit a warning (default in tests)
# disabled → skip verification entirely (local development only)
# ASSIGNEE_BP_INTEGRITY=enforce
# Require a valid GPG signature on the BP manifest before loading.
# ASSIGNEE_BP_REQUIRE_SIGNATURE=
# Opt-in: sign the BP manifest with this GPG key id / email (generator side).
# ASSIGNEE_BP_SIGNING_KEY=

# ── Config directory override ─────────────────────────────────────────────────
# Default is ~/.assignee/. Override for tests, sandboxes, or multi-tenant hosts.
# ASSIGNEE_CONFIG_DIR=

# ── Always-on log directory override ──────────────────────────────────────────
# Directory used for the persistent warn/error log file. Defaults to
# ~/.assignee/logs. Tests override this to keep state isolated.
# ASSIGNEE_LOG_DIR=

# ── Log retention (days) ──────────────────────────────────────────────────────
# How many days of persistent warn/error log files to keep before
# `assignee clean --logs` deletes them. Defaults to 14. Must be a positive
# integer; non-numeric/zero/negative values fall back to the default.
# ASSIGNEE_LOG_RETENTION_DAYS=14

# ── Optional remote knowledge MCP server ─────────────────────────────────────
# Set to exactly "1" to enable the remote knowledge MCP server. SECURITY: when
# enabled, the CLI fetches and executes a remote MCP server over the network.
# Only enable in trusted environments.
# ASSIGNEE_ENABLE_REMOTE_MCP=1

# ── E2E test gate ─────────────────────────────────────────────────────────────
# Gates the end-to-end test suite. Set to 1 to opt in; otherwise the suite is
# skipped during `pnpm test`.
# RUN_E2E=1

# ── Distributed tracing / OTLP exporter ──────────────────────────────────────
# When set, every structured log event is also POSTed to <endpoint>/v1/logs in
# OTLP/HTTP-JSON format. Errors and timeouts are swallowed silently.
# Example: http://localhost:4318 for a local OpenTelemetry Collector.
# ASSIGNEE_OTEL_ENDPOINT=
# ASSIGNEE_OTEL_SERVICE_NAME=assignee-cli

# ── Verbosity / logging (optional) ────────────────────────────────────────────
# Set either to enable structured JSON log output to stderr.
# ASSIGNEE_VERBOSITY=verbose
# ASSIGNEE_LOG_LEVEL=debug

# ── Recording (optional) ─────────────────────────────────────────────────────
# Set to 1 to record all MCP + LLM calls for replay/debugging.
# ASSIGNEE_RECORD=1

# ── No telemetry ──────────────────────────────────────────────────────────────
# Set to 1 to disable all telemetry.
# ASSIGNEE_NO_TELEMETRY=1

# ── Demo / screenshot mode ────────────────────────────────────────────────────
# When set to 1, all 12-digit AWS account IDs in CLI output are redacted to
# [ACCOUNT] — useful for demos, screenshots, and docs.
#
# IMPORTANT: This is a demo/CI-only override. Do NOT set it in `.env` (which
# may be loaded by any dotenv-aware process). Put it in `.env.local` instead —
# that file is gitignored and will not leak into CI dogfood runs.
# Example .env.local entry:
#   ASSIGNEE_DEMO_REDACT_ACCOUNT=1
# ASSIGNEE_DEMO_REDACT_ACCOUNT=1

# ── SaaS API (future) ────────────────────────────────────────────────────────
# ASSIGNEE_SAAS_URL=https://app.assignee.ai
# ASSIGNEE_ORG_POLICY_TTL_MS=300000
