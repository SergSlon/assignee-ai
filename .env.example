# Assignee.ai — environment variables
# Copy to .env and fill in real values. Never commit .env.
# Run `assignee setup` to auto-generate IAM users and credentials.

# ── Operator (assignee-operator) ─────────────────────────────────────────────
# Used directly by the CLI for Amazon Bedrock + CloudControl provisioning.
# Highest privilege — scoped to Bedrock invoke and supported resource types.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1

# ── Reader (assignee-reader) ─────────────────────────────────────────────────
# Passed to MCP server subprocesses that need schema, pricing, and billing data.
# Read-only: CloudFormation schema, Pricing API, Cost Explorer.
ASSIGNEE_READER_ACCESS_KEY_ID=AKIA...
ASSIGNEE_READER_SECRET_ACCESS_KEY=...

# ── Auditor (assignee-auditor) ───────────────────────────────────────────────
# Passed to MCP server subprocesses that assess security posture.
# Read-only: IAM simulate, SecurityHub, GuardDuty, Inspector, Access Analyzer.
ASSIGNEE_AUDITOR_ACCESS_KEY_ID=AKIA...
ASSIGNEE_AUDITOR_SECRET_ACCESS_KEY=...

# ── Bedrock model (optional override) ─────────────────────────────────────────
# Defaults to us.amazon.nova-lite-v1:0. Override to use a different model/profile.
# BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# ── Bedrock Guardrail (optional) ──────────────────────────────────────────────
# Suppresses guardrail_disabled warning in logs. Leave blank to skip.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=
