# Assignee.ai — environment variables
# Copy to .env and fill in real values. Never commit .env.
# Run `assignee setup` to auto-generate dedicated IAM users (recommended).
#
# All vars are commented-out — they are examples, not active config.
# Supply real credentials/values by un-commenting and editing.
#
# ── SSO / federated users (root account, AWS Identity Center, etc.) ──────────
# If you logged in with `aws sso login` / `aws login` / SSM and have temp creds
# in your default AWS profile, you can dump them into this file with:
#   aws configure export-credentials --format env-no-export
# Then paste AWS_ACCESS_KEY_ID → ASSIGNEE_OPERATOR_ACCESS_KEY_ID, the secret →
# ASSIGNEE_OPERATOR_SECRET_ACCESS_KEY, and AWS_SESSION_TOKEN →
# ASSIGNEE_OPERATOR_SESSION_TOKEN. Repeat for Reader/Auditor (same creds is
# fine for single-account dev). Sessions expire — re-export when STS bounces.

# ============================================================
# REQUIRED — Production credentials and Bedrock region
# ============================================================
# Operator / Reader / Auditor key triplets plus AWS_REGION, and
# optional Bedrock Guardrail IDs. Every production deployment needs
# the three credential triplets and AWS_REGION at minimum.

# ── Operator (assignee-operator) ─────────────────────────────────────────────
# Used directly by the CLI for Amazon Bedrock + CloudControl provisioning.
# Highest privilege — scoped to Bedrock invoke and supported resource types.
# ASSIGNEE_OPERATOR_ACCESS_KEY_ID=AKIA...
# ASSIGNEE_OPERATOR_SECRET_ACCESS_KEY=...
# Required for STS / federated / SSO / root-via-Identity-Center temp credentials.
# Long-lived IAM-user keys (AKIA...) leave this blank.
# ASSIGNEE_OPERATOR_SESSION_TOKEN=

# Default AWS region used by the operator credential set.
# AWS_REGION=us-east-1

# ── Reader (assignee-reader) ─────────────────────────────────────────────────
# Passed to MCP server subprocesses that need schema, pricing, and billing data.
# Read-only: CloudFormation schema, Pricing API, Cost Explorer.
# ASSIGNEE_READER_ACCESS_KEY_ID=AKIA...
# ASSIGNEE_READER_SECRET_ACCESS_KEY=...
# ASSIGNEE_READER_SESSION_TOKEN=

# ── Auditor (assignee-auditor) ───────────────────────────────────────────────
# Passed to MCP server subprocesses that assess security posture.
# Read-only: IAM simulate, SecurityHub, GuardDuty, Inspector, Access Analyzer.
# ASSIGNEE_AUDITOR_ACCESS_KEY_ID=AKIA...
# ASSIGNEE_AUDITOR_SECRET_ACCESS_KEY=...
# ASSIGNEE_AUDITOR_SESSION_TOKEN=

# ── Bedrock Guardrail (REQUIRED for production, optional for local dev) ──────
# Applies to all bedrock/ models. The CLI hard-fails on any Bedrock call
# unless either (a) both BEDROCK_GUARDRAIL_ID + BEDROCK_GUARDRAIL_VERSION are
# set, or (b) the explicit dev opt-out below is set.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=

# ============================================================
# AWS SDK fallbacks (optional)
# ============================================================
# Standard AWS SDK environment variables used as fallbacks when the
# ASSIGNEE_* credential blocks above are empty. Most users leave these
# commented.

# AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# ============================================================
# LLM provider (optional)
# ============================================================
# Selects the default LLM model for all pipeline nodes and sets
# provider API keys. Leave unset to use the built-in default
# (bedrock/amazon.nova-lite-v1:0).

# Selects the default LLM model ID for all pipeline nodes. Format:
# "provider/model-id". Supported providers: bedrock, anthropic, openai,
# google, ollama. This is the only wired routing env-var today.
# (Per-node overrides ASSIGNEE_LLM_PLAN_GENERATOR, ASSIGNEE_LLM_INTENT_PARSER,
# ASSIGNEE_LLM_ADVICE_GENERATOR, ASSIGNEE_LLM_WORKLOAD_CLASSIFIER were defined
# in Story 44.1 but never implemented — retired in Epic 100 R9b.)
# ASSIGNEE_LLM_DEFAULT=bedrock/amazon.nova-lite-v1:0

# Deprecated alias for ASSIGNEE_LLM_DEFAULT — accepted for backward
# compatibility. Prefer ASSIGNEE_LLM_DEFAULT for new configurations.
# ASSIGNEE_MODEL=bedrock/amazon.nova-lite-v1:0

# Non-Bedrock provider API keys (required only when ASSIGNEE_LLM_DEFAULT
# points at a non-Bedrock provider).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ============================================================
# LLM retry & resilience
# ============================================================
# Controls how the LLM adapter retries Bedrock throttling errors.

# Maximum number of per-call retry attempts for transient Bedrock throttling
# errors (ThrottlingException / ServiceUnavailableException /
# TooManyRequestsException). Integer in [0, 10]. Default: 3.
# ASSIGNEE_LLM_MAX_RETRIES=3

# Base delay in milliseconds for exponential-backoff retry.
# Integer in [100, 30000]. Default: 1000.
# ASSIGNEE_LLM_RETRY_BASE_MS=1000

# Maximum cumulative ThrottlingException retries (across all concurrent
# calls) within a 60-second sliding window before fast-failing.
# Integer in [1, 100]. Default: 20. SEC-028.
# ASSIGNEE_LLM_MAX_GLOBAL_RETRIES=20

# ============================================================
# Guardrails & security
# ============================================================
# Opt-outs and strict-mode flags for the Bedrock Guardrail gate and
# preflight verification.

# Dev opt-out: set EXACTLY "1" (strict-bool parser rejects "true", "yes", etc.).
# Suppresses the "running WITHOUT a Guardrail" warning AND skips the hard-fail.
# This is also the global opt-out for the one-time non-Bedrock provider
# guardrail-absence warning (SEC-042). Only the value "1" is accepted.
# NEVER set this in production. SEC-016, SEC-042.
# ASSIGNEE_ALLOW_NO_GUARDRAIL=1

# To suppress JUST the warning while still enforcing the hard-fail (e.g. you've
# accepted the risk and don't want stderr noise on every run): set EXACTLY "1".
# BEDROCK_GUARDRAIL_DISABLE=1

# Opt-in strict mode: when set to "1", the managed-policy preflight guard
# treats unknown verification errors as fail-closed instead of the default
# fail-open+WARN. Useful for SaaS tenants that want to abort on any
# verification anomaly.
# ASSIGNEE_PREFLIGHT_UNKNOWN_BLOCKS=1

# ============================================================
# RBAC & identity
# ============================================================
# Role override and OIDC adapter selection for SaaS / CI flows.

# Override the active RBAC role for the current CLI invocation.
# Accepted values: "operator" | "reader" | "auditor". Used in tests
# and SaaS multi-tenant flows to avoid re-reading the OIDC token on
# every call. SEC-038.
# ASSIGNEE_ROLE=operator

# When set, the CLI skips the built-in OIDC-provider selection dialog
# in `assignee init` and uses the specified adapter name directly.
# Intended for CI / automated provisioning flows.
# ASSIGNEE_OIDC_ADAPTER=

# ============================================================
# CLI behaviour
# ============================================================
# Overrides for CLI preferences that can also be set in
# .assignee/config.yaml or ~/.config/assignee/config.yaml.

# ask | apply | skip — auto-fix behaviour for best-practice violations.
# ASSIGNEE_AUTO_FIX=ask

# Default region used when none is specified in a command or config file.
# ASSIGNEE_DEFAULT_REGION=us-east-1

# Comma-separated key=value tags applied to every provisioned resource.
# ASSIGNEE_DEFAULT_TAGS=env=dev,team=platform

# When set to "1", the pre-plan clarifying-question step is bypassed.
# Useful in non-interactive / scripted invocations where an upstream
# system already ensures the intent is unambiguous. Story 56-it2-04.
# ASSIGNEE_NO_CLARIFIER=1

# When set to "1", all 12-digit AWS account IDs in CLI output are redacted
# to [ACCOUNT] — useful for demos, screenshots, and docs. Does not affect
# the audit log or LLM prompts. IMPORTANT: use .env.local (gitignored) —
# not .env — to avoid leaking into CI dogfood runs.
# ASSIGNEE_DEMO_REDACT_ACCOUNT=1

# Set to "verbose" to enable structured JSON log output to stderr.
# ASSIGNEE_VERBOSITY=verbose

# Set to "debug" (or any standard level) to control structured log verbosity.
# ASSIGNEE_LOG_LEVEL=debug

# ============================================================
# Paths: config, logs, audit
# ============================================================
# Directory and retention overrides for config, operational logs, and the
# tamper-evident audit log.

# Config directory override. Default: ~/.assignee/.
# Override for tests, sandboxes, or multi-tenant hosts.
# ASSIGNEE_CONFIG_DIR=

# Directory used for the persistent warn/error log file.
# Defaults to ~/.assignee/logs. Tests override this to keep state isolated.
# ASSIGNEE_LOG_DIR=

# How many days of persistent warn/error log files to keep before
# `assignee clean --logs` deletes them. Defaults to 30. Must be a positive
# integer ≥ 30; the doctor check enforces 30 as the minimum floor.
# Non-numeric/zero/negative values fall back to 30.
# ASSIGNEE_LOG_RETENTION_DAYS=30

# Override the minimum audit-log retention floor (default 90 days).
# Values BELOW 90 are rejected at config-load time with a clear error —
# the 90-day floor is a hard compliance requirement (ISO 27001 A.12.4 +
# GDPR Art 30 ROPA). Only values ≥ 90 are accepted.
# ASSIGNEE_AUDIT_RETENTION_DAYS=90

# When set to "1", the audit-log HMAC key is sourced from this env var
# instead of the key file on disk. Intended for SaaS / CI callers that
# inject a per-tenant secret without touching the filesystem.
# ASSIGNEE_AUDIT_KEY=

# When set to "0", the post-append fsync calls are skipped for audit-log
# writes. Improves throughput in test / high-write environments at the cost
# of kernel-crash durability. NEVER set in production. SEC-043.
# ASSIGNEE_AUDIT_FSYNC=0

# ============================================================
# MCP server
# ============================================================
# Concurrency and audit-log overrides for the MCP server process.

# Maximum number of concurrently running apply operations in the MCP server.
# Integer. Default behaviour is defined in active-applies.ts.
# ASSIGNEE_MCP_MAX_ACTIVE_APPLIES=

# Override the directory where the MCP server writes its per-session audit log.
# Defaults to the standard audit-log directory. Used in tests to redirect
# writes to a temp directory.
# ASSIGNEE_MCP_AUDIT_DIR=

# ============================================================
# Telemetry & OTLP
# ============================================================
# Internal event telemetry adapter, OTLP exporter endpoint, and
# privacy / security controls for the exporter.

# Opt-in telemetry adapter. Telemetry is OFF by default (L1-F52 — no
# vendor phone-home unless this is set). Accepted values: in-memory | file
# (additional adapters added in Epic 102). Absent or empty → no-op.
# ASSIGNEE_TELEMETRY_ADAPTER=

# Set to 1 to disable all telemetry (ASSIGNEE_NO_TELEMETRY=1 takes
# precedence over ASSIGNEE_TELEMETRY_ADAPTER).
# ASSIGNEE_NO_TELEMETRY=1

# When set, every structured log event is also emitted to the OTLP/HTTP-JSON
# /v1/logs endpoint at this URL. Errors and timeouts are swallowed silently —
# the exporter never blocks or crashes the CLI.
# Example: http://localhost:4318 for a local OpenTelemetry Collector.
# ASSIGNEE_OTEL_ENDPOINT=

# Optional service.name attribute attached to every emitted log record.
# Defaults to "assignee-cli" when unset.
# ASSIGNEE_OTEL_SERVICE_NAME=

# When set to "1", the OTEL exporter allows plaintext HTTP endpoints.
# By default only HTTPS endpoints are accepted to prevent accidental
# telemetry exfiltration over an unencrypted channel.
# Intended for local development / loopback collectors only.
# ASSIGNEE_OTEL_ALLOW_HTTP=1

# When set to "1", the OTEL exporter allows any HTTPS hostname as an
# endpoint without consulting the built-in or operator-supplied allowlist.
# Intended for development / custom collector setups only. F026 / SEC-023.
# ASSIGNEE_OTEL_ALLOW_ANY_HOSTNAME=1

# SEC-023: comma-separated list of acceptable OTLP endpoint hostnames.
# When set, the OTEL exporter rejects any endpoint whose hostname is not
# in this list. Default is no allowlist (all hostnames permitted).
# Example: collector.example.com,otel.internal
# ASSIGNEE_OTEL_ENDPOINT_ALLOWLIST=

# When set to "1", the OTEL exporter includes PII-classified fields in
# emitted events. When unset or "0", PII fields are stripped at the
# source-side allowlist before export.
# ASSIGNEE_OTEL_INCLUDE_PII=1

# Set to 1 to record all MCP + LLM calls for replay/debugging.
# ASSIGNEE_RECORD=1

# ============================================================
# Nightly / FinOps (CI-only)
# ============================================================
# Budget caps and ledger paths for nightly E2E smoke runs and the
# monthly FinOps aggregate report. Do not set these in developer .env files.

# Maximum total USD cost budget for a single nightly E2E destroy smoke run.
# When the estimated remaining cost of un-provisioned resources would breach
# this cap, the suite exits early and emits a budget_exceeded event to the
# cost ledger. Default: "5" ($5/day).
# ASSIGNEE_NIGHTLY_BUDGET_USD=5

# Directory where nightly E2E cost ledger JSONL files are written.
# Defaults to ~/.assignee/logs/. Each file is named
# nightly-cost-YYYY-MM-DD.jsonl and contains one JSON record per
# provisioned+destroyed resource type.
# ASSIGNEE_NIGHTLY_LEDGER_DIR=

# Monthly CI spend ceiling for the FinOps aggregate report.
# When the rolling 30-day CI spend exceeds this value, the report emits
# a ALERT and suggests raising the ceiling or reducing nightly-e2e scope.
# Default: 50 ($50/month). CI default used in finops-aggregate.mjs.
# ASSIGNEE_FINOPS_MONTHLY_BUDGET_USD=50

# ============================================================
# Test gates (developer-only)
# ============================================================
# Feature flags that gate expensive test suites. Never set these in
# production or CI environments unless running the specific suite.
# Other test flags are documented in docs/testing-guide.md.

# Gates the end-to-end test suite. Set to 1 to opt in; otherwise the suite
# is skipped during `pnpm test`.
# RUN_E2E=1

# ============================================================
# SaaS (future)
# ============================================================
# Reserved for future SaaS / hosted-service integration. Not wired today.

# ASSIGNEE_SAAS_URL=https://app.assignee.ai
# ASSIGNEE_ORG_POLICY_TTL_MS=300000
