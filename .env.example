# Assignee.ai — environment variables
# Copy to .env and fill in real values. Never commit .env.

# ── Bedrock (bedrock-dev-user) ────────────────────────────────────────────────
# Used directly by the CLI for Amazon Bedrock API calls (Nova Lite).
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=eu-west-1

# ── MCP servers (aws-mcp-user) ────────────────────────────────────────────────
# Passed explicitly to MCP server subprocesses (CCAPI, CFN schema, pricing).
# Separate identity with least-privilege for provisioning operations.
MCP_AWS_ACCESS_KEY_ID=AKIA...
MCP_AWS_SECRET_ACCESS_KEY=...

# ── Bedrock Guardrail (optional) ──────────────────────────────────────────────
# Suppresses guardrail_disabled warning in logs. Leave blank to skip.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=
