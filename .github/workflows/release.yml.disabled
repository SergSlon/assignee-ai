name: Release

# ──────────────────────────────────────────────────────────────────────────────
# Release / publish workflow.
#
# STATUS: DISABLED (owner decision — all packages stay `"private": true` until
# the tool is approved for public distribution). This file is kept as
# `release.yml.disabled` so GitHub Actions never picks it up. To enable:
#
#   1. Remove `"private": true` from every package.json that should ship.
#   2. Rename this file to `release.yml`.
#   3. Publish is gated on `workflow_dispatch` + an explicit `confirm=YES_PUBLISH`
#      input (see `jobs.<job>.if` below). Even after renaming, nothing happens
#      on tag push alone — a human still has to trigger it manually.
#
# Tooling notes:
#   - Uses `pnpm -r publish` so `workspace:*` deps are rewritten to real
#     versions at publish time. `npm publish` cannot resolve `workspace:*`.
#   - Uses OIDC provenance (`permissions: id-token: write`). No long-lived
#     NPM_TOKEN secret is required; npm picks up the OIDC identity.
#   - Runs `npm pack --dry-run` per publishable package first so metadata
#     regressions (missing description/license/files) abort the run BEFORE
#     anything hits the registry.
#   - Per-package LICENSE files live at `apps/cli/LICENSE`,
#     `apps/mcp-server/LICENSE`, `packages/core/LICENSE`,
#     `packages/best-practices/LICENSE` (byte-for-byte copies of the root).
#     Local `pnpm -r publish --dry-run` therefore produces identical
#     tarballs to CI — no more "CI-only LICENSE copy" drift (L9-B2).
#   - `package-binaries` uses `pnpm deploy --prod --filter=assignee` to
#     produce a self-contained CLI directory that includes the resolved
#     production `node_modules`. This is what the Homebrew formula
#     actually unpacks — users need `@ai-sdk/*` and other runtime deps
#     present locally or `assignee --version` crashes on first import
#     (L9-B1).
#   - `cross-platform-build` runs the full matrix on macOS + Windows
#     before any publish step. Catches path-handling / shell-dependent
#     bugs that the ubuntu-only default gate misses (L9-H3).
#   - `smoke-test` unpacks the CLI tarball and asserts
#     `node dist/index.js --version` matches the release tag before
#     users ever see it (L9-H5).
# ──────────────────────────────────────────────────────────────────────────────

on:
  workflow_dispatch:
    inputs:
      confirm:
        description: 'Type YES_PUBLISH to actually publish to npm. Any other value is a dry-run.'
        required: true
        default: 'DRY_RUN'
      tag:
        description: 'Git tag to release (e.g. v0.1.0). Must already exist and point at the commit to publish.'
        required: true

permissions:
  contents: write
  # Required for npm provenance — replaces the legacy NPM_TOKEN secret.
  id-token: write

jobs:
  # --------------------------------------------------------------------------
  # Build and test — gate the whole pipeline on a green ubuntu build. Runs
  # first so every downstream job has a cached install. `cross-platform-build`
  # below re-runs the same suite on macOS + Windows in parallel.
  # --------------------------------------------------------------------------
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.tag }}

      - uses: pnpm/action-setup@v4
        with:
          version: 10.32.1

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build all packages
        run: npx turbo build

      - name: Run all tests
        run: npx turbo test

      - name: Upload CLI build artifact
        uses: actions/upload-artifact@v4
        with:
          name: cli-dist
          path: |
            apps/cli/dist/
            apps/cli/completions/
            apps/cli/package.json
            apps/cli/README.md
            apps/cli/LICENSE

  # --------------------------------------------------------------------------
  # Cross-platform build — re-runs build + test on macOS and Windows so a
  # platform-specific regression blocks publish. Gated on `needs: build` so
  # ubuntu runs first and caches pnpm; macOS/Windows then hit warm caches.
  # fail-fast: false because we want both platforms to report even if one
  # fails.
  # --------------------------------------------------------------------------
  cross-platform-build:
    needs: build
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.tag }}

      - uses: pnpm/action-setup@v4
        with:
          version: 10.32.1

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build all packages
        run: pnpm build

      - name: Run all tests
        run: pnpm test

  # --------------------------------------------------------------------------
  # Publish dry-run — runs `npm pack --dry-run` per publishable package so
  # metadata regressions (missing description, license, repository, files)
  # fail BEFORE the real publish step. Gated on cross-platform-build so a
  # macOS-only test failure blocks publish.
  # --------------------------------------------------------------------------
  publish-dry-run:
    needs: cross-platform-build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.tag }}

      - uses: pnpm/action-setup@v4
        with:
          version: 10.32.1

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'pnpm'
          registry-url: 'https://registry.npmjs.org'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build all packages
        run: npx turbo build

      - name: Dry-run npm pack per package (metadata audit)
        # Per-package LICENSE now lives at <pkg>/LICENSE as a real file
        # (byte-for-byte copy of root LICENSE). No pre-copy step needed —
        # local `pnpm -r publish --dry-run` produces identical output.
        run: |
          set -euo pipefail
          for dir in apps/cli apps/mcp-server packages/core packages/best-practices; do
            echo "────────────────────────────────────────"
            echo "npm pack --dry-run for $dir"
            echo "────────────────────────────────────────"
            (cd "$dir" && npm pack --dry-run)
          done

  # --------------------------------------------------------------------------
  # Publish to npm — gated on confirm=YES_PUBLISH. Uses `pnpm -r publish` so
  # `workspace:*` specs are rewritten to real versions. Provenance is attached
  # automatically because `id-token: write` is in permissions.
  # --------------------------------------------------------------------------
  publish-npm:
    needs: publish-dry-run
    if: inputs.confirm == 'YES_PUBLISH'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.tag }}

      - uses: pnpm/action-setup@v4
        with:
          version: 10.32.1

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'pnpm'
          registry-url: 'https://registry.npmjs.org'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build all packages
        run: npx turbo build

      - name: Publish all packages (workspace-aware, with provenance)
        # pnpm publishes each non-private package in dependency order and
        # rewrites workspace:* specs into concrete versions in the tarball.
        # --no-git-checks: we're on a CI runner without a clean work tree.
        # --access public: required for scoped packages.
        # --provenance: attaches sigstore attestation via OIDC id-token.
        run: pnpm -r publish --access public --provenance --no-git-checks

  # --------------------------------------------------------------------------
  # Create platform tarballs for GitHub release.
  #
  # IMPORTANT: we use `pnpm deploy --prod --filter=assignee <dir>` to produce
  # a self-contained deploy directory that includes the resolved production
  # `node_modules`. Tarring only `dist/` ships broken bits — users get
  # `Cannot find package '@ai-sdk/amazon-bedrock'` on first run because
  # workspace:* deps aren't resolved and runtime deps aren't bundled.
  # The Homebrew formula relies on `libexec.install Dir["*"]` picking up
  # `node_modules` from the tarball (L9-B1).
  # --------------------------------------------------------------------------
  package-binaries:
    needs: cross-platform-build
    if: inputs.confirm == 'YES_PUBLISH'
    runs-on: ubuntu-latest
    strategy:
      matrix:
        include:
          - platform: darwin-arm64
          - platform: darwin-x64
          - platform: linux-x64
          - platform: linux-arm64
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.tag }}

      - uses: pnpm/action-setup@v4
        with:
          version: 10.32.1

      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build all packages
        run: npx turbo build

      - name: Produce self-contained CLI deploy directory
        # `pnpm deploy` resolves workspace:* deps to real versions, strips
        # devDeps, and materialises a standalone node_modules tree. The
        # resulting apps/cli/deploy/ directory is what Homebrew unpacks.
        run: pnpm deploy --prod --filter=assignee apps/cli/deploy

      - name: Stage deploy contents for tarball
        run: |
          set -euo pipefail
          # `pnpm deploy` copies package.json and dist/ but does NOT
          # automatically include the unversioned bits the formula needs
          # (generated completions, root LICENSE fallback for brew audit).
          # Copy them explicitly. README is already present via pnpm deploy.
          cp -r apps/cli/completions apps/cli/deploy/completions
          test -f apps/cli/deploy/LICENSE || cp apps/cli/LICENSE apps/cli/deploy/LICENSE
          test -f apps/cli/deploy/README.md || cp apps/cli/README.md apps/cli/deploy/README.md

      - name: Create platform tarball
        run: |
          VERSION="${{ inputs.tag }}"
          TARBALL="assignee-${VERSION}-${{ matrix.platform }}.tar.gz"
          tar -czf "${TARBALL}" -C apps/cli/deploy .
          echo "TARBALL=${TARBALL}" >> "$GITHUB_ENV"
          echo "TARBALL_NAME=${TARBALL}" >> "$GITHUB_ENV"

      - name: Upload platform tarball
        uses: actions/upload-artifact@v4
        with:
          # Use the canonical filename (assignee-${VERSION}-${platform}.tar.gz)
          # as the artifact name so downstream jobs can locate it deterministically.
          name: assignee-${{ inputs.tag }}-${{ matrix.platform }}.tar.gz
          path: ${{ env.TARBALL }}

  # --------------------------------------------------------------------------
  # GitHub Release
  # --------------------------------------------------------------------------
  github-release:
    needs: [publish-npm, package-binaries]
    if: inputs.confirm == 'YES_PUBLISH'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
          ref: ${{ inputs.tag }}

      - name: Download all tarballs
        uses: actions/download-artifact@v4
        with:
          pattern: assignee-${{ inputs.tag }}-*.tar.gz
          merge-multiple: true
          path: release-assets/

      - name: Generate changelog
        id: changelog
        run: |
          # Get previous tag
          PREV_TAG=$(git tag --sort=-v:refname | head -2 | tail -1)
          if [ -z "$PREV_TAG" ]; then
            CHANGELOG=$(git log --oneline --no-decorate)
          else
            CHANGELOG=$(git log --oneline --no-decorate "${PREV_TAG}..HEAD")
          fi
          # Write to file to handle multiline
          echo "$CHANGELOG" > changelog.txt

      - name: Create GitHub Release
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ inputs.tag }}
          body_path: changelog.txt
          files: release-assets/*
          generate_release_notes: true
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  # --------------------------------------------------------------------------
  # Smoke-test — download the published tarball, extract, and run
  # `node dist/index.js --version`. Asserts the version string matches the
  # release tag. Runs on ubuntu only because cross-platform verification is
  # handled by cross-platform-build above; this is the final tarball-integrity
  # gate before anyone runs `brew install` (L9-H5).
  # --------------------------------------------------------------------------
  smoke-test:
    needs: github-release
    if: inputs.confirm == 'YES_PUBLISH'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Download linux-x64 tarball
        uses: actions/download-artifact@v4
        with:
          name: assignee-${{ inputs.tag }}-linux-x64.tar.gz
          path: smoke/

      - name: Extract tarball
        run: |
          set -euo pipefail
          mkdir -p smoke/unpacked
          tar -xzf smoke/assignee-${{ inputs.tag }}-linux-x64.tar.gz -C smoke/unpacked

      - name: Assert CLI runs and prints the release tag
        run: |
          set -euo pipefail
          EXPECTED="${{ inputs.tag }}"
          # Strip the leading 'v' if the tag is vX.Y.Z; --version prints the
          # package.json version which omits the v.
          EXPECTED_STRIPPED="${EXPECTED#v}"
          cd smoke/unpacked
          OUTPUT="$(node dist/index.js --version)"
          echo "assignee --version → $OUTPUT"
          if ! echo "$OUTPUT" | grep -qE "(^|[^0-9])${EXPECTED_STRIPPED}([^0-9]|$)"; then
            echo "::error::Tarball version mismatch. Expected ${EXPECTED_STRIPPED}, got: $OUTPUT" >&2
            exit 1
          fi

  # --------------------------------------------------------------------------
  # Update Homebrew formula — computes sha256 per arch and patches the tap.
  # --------------------------------------------------------------------------
  update-homebrew:
    needs: smoke-test
    if: inputs.confirm == 'YES_PUBLISH'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          ref: ${{ inputs.tag }}

      - name: Download darwin-arm64 tarball
        uses: actions/download-artifact@v4
        with:
          name: assignee-${{ inputs.tag }}-darwin-arm64.tar.gz
          path: release-assets/

      - name: Download darwin-x64 tarball
        uses: actions/download-artifact@v4
        with:
          name: assignee-${{ inputs.tag }}-darwin-x64.tar.gz
          path: release-assets/

      - name: Download linux-x64 tarball
        uses: actions/download-artifact@v4
        with:
          name: assignee-${{ inputs.tag }}-linux-x64.tar.gz
          path: release-assets/

      - name: Download linux-arm64 tarball
        uses: actions/download-artifact@v4
        with:
          name: assignee-${{ inputs.tag }}-linux-arm64.tar.gz
          path: release-assets/

      - name: Compute sha256 per platform
        id: sha
        run: |
          VERSION="${{ inputs.tag }}"
          declare -A PLATFORMS=( \
            [darwin_arm64]="darwin-arm64" \
            [darwin_x64]="darwin-x64" \
            [linux_x64]="linux-x64" \
            [linux_arm64]="linux-arm64" \
          )
          for key in "${!PLATFORMS[@]}"; do
            platform="${PLATFORMS[$key]}"
            TARBALL="release-assets/assignee-${VERSION}-${platform}.tar.gz"
            if [ ! -f "$TARBALL" ]; then
              echo "Expected tarball not found: $TARBALL" >&2
              ls -la release-assets/ >&2
              exit 1
            fi
            SHA=$(shasum -a 256 "$TARBALL" | awk '{print $1}')
            echo "sha_${key}=$SHA" >> "$GITHUB_OUTPUT"
          done

      - name: Update Homebrew formula
        env:
          HOMEBREW_TAP_TOKEN: ${{ secrets.HOMEBREW_TAP_TOKEN }}
        run: |
          VERSION="${{ inputs.tag }}"
          SHA_DARWIN_ARM64="${{ steps.sha.outputs.sha_darwin_arm64 }}"
          SHA_DARWIN_X64="${{ steps.sha.outputs.sha_darwin_x64 }}"
          SHA_LINUX_X64="${{ steps.sha.outputs.sha_linux_x64 }}"
          SHA_LINUX_ARM64="${{ steps.sha.outputs.sha_linux_arm64 }}"

          # Clone the tap repo
          git clone "https://x-access-token:${HOMEBREW_TAP_TOKEN}@github.com/assignee-ai/homebrew-assignee.git" tap

          # Render the multi-platform formula from the repo's template copy
          # (homebrew/assignee.rb) and drop it into the tap. We use envsubst
          # so per-arch url/sha256 blocks stay declarative.
          export VERSION SHA_DARWIN_ARM64 SHA_DARWIN_X64 SHA_LINUX_X64 SHA_LINUX_ARM64
          envsubst < homebrew/assignee.rb > tap/Formula/assignee.rb

          # Commit and push
          cd tap
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add Formula/assignee.rb
          git commit -m "Update assignee to ${VERSION}" || echo "No changes to commit"
          git push
