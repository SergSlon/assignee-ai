.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Plan checkpoint files (regenerable via `assignee plan`)
.assignee

# MCP capture pipeline intermediate files (regenerable via scripts)
apps/cli/scripts/processed-responses/

# Recording session output (transient, not committed)
apps/cli/src/test-fixtures/recordings/

# Agent-session artifacts, Claude Code state, and BMAD output all live
# at the PARENT directory (/Users/.../code/GenAi/) not inside this repo.
# If subagents accidentally create copies here, gitignore prevents them
# from being committed.
.agents/
.claude/
_bmad-output/
