# Dependencies
node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Plan checkpoint files (regenerable via `assignee plan`)
.assignee

# MCP capture pipeline intermediate files (regenerable via scripts)
apps/cli/scripts/processed-responses/

# Recording session output (transient, not committed)
apps/cli/src/test-fixtures/recordings/

# Agent-session artifacts — handoff notes, per-epic expert review reports.
# These are point-in-time snapshots that become stale fast; keeping them in
# the repo creates noise for clones and tempts new contributors to read
# obsolete findings instead of current code / commit messages.
.agents/

# Local Claude Code project state — auto-memory, session context, personal
# operating preferences. Normally lives at ~/.claude/projects/... but stray
# copies have landed in this tree. Never belongs in a shared repo.
.claude/
