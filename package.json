{
  "name": "assignee-ai",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:mock-fixture-drift": "npx tsx --import ./scripts/_vitest-shim.mts scripts/check-mock-fixture-drift.mts",
    "citation-lint": "node apps/cli/scripts/citation-lint.mjs",
    "doc-lint": "node apps/cli/scripts/doc-lint.mjs",
    "lint:shims": "node apps/cli/scripts/no-new-cli-shims.mjs",
    "lint:barrels": "node apps/cli/scripts/check-config-barrel-circular.mjs",
    "lint:ci-multiplier": "node apps/cli/scripts/lint-ci-multiplier.mjs",
    "lint:tracker-leak": "node apps/cli/scripts/tracker-leak-lint.mjs",
    "reviewer-evidence-audit": "tsx scripts/reviewer-evidence-audit.ts",
    "backup-provisions": "npx tsx scripts/backup-provisions.ts",
    "audit-github-org": "npx tsx scripts/audit-github-org.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1045.0",
    "@vitest/coverage-v8": "^3.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "turbo": "^2.8.17",
    "typescript": "5.9.2",
    "vitest": "^3.1.0"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.11",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch@<3.1.5": "^3.1.5",
      "minimatch@>=9.0.0 <9.0.9": "^9.0.9",
      "minimatch@>=10.0.0 <10.2.5": "^10.2.5",
      "brace-expansion@<1.1.13": "^1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "^2.0.3",
      "brace-expansion@>=4.0.0 <5.0.5": "^5.0.5",
      "path-to-regexp@>=8.0.0 <8.4.2": "^8.4.2",
      "fast-xml-parser": "5.5.8",
      "ip-address@<10.1.1": "^10.1.1",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "js-yaml@>=4.0.0 <4.1.1": "^4.1.1",
      "flatted@<3.4.2": "^3.4.2",
      "vite@>=7.0.0 <7.3.2": "^7.3.2",
      "ajv@<6.14.0": "^6.14.0",
      "langsmith": "^0.6.0",
      "hono": "^4.12.16",
      "@hono/node-server": "^1.19.13",
      "uuid@<14.0.0": "^14.0.0",
      "postcss@<8.5.10": "^8.5.10",
      "fast-uri@<3.1.1": "^3.1.2"
    },
    "auditConfig": {
      "ignoreCves": [
        "CVE-2026-41650"
      ]
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  }
}
