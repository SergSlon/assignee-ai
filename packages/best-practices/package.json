{
  "name": "@assignee/best-practices",
  "version": "0.1.0",
  "private": true,
  "description": "YAML-defined AWS best-practice rules plus the loader, schema, evaluator, and integrity checker that power Assignee.ai's BP enforcement.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest.json": "./manifest.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.*",
    "manifest.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SergSlon/assignee-ai.git",
    "directory": "packages/best-practices"
  },
  "homepage": "https://github.com/SergSlon/assignee-ai#readme",
  "bugs": {
    "url": "https://github.com/SergSlon/assignee-ai/issues"
  },
  "keywords": [
    "assignee",
    "aws",
    "best-practices",
    "infrastructure",
    "iac",
    "security",
    "compliance",
    "yaml",
    "rules-engine",
    "policy"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "generate-manifest": "tsx scripts/generate-manifest.ts"
  },
  "dependencies": {
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@assignee/eslint-config": "workspace:*",
    "@assignee/tsconfig": "workspace:*",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.5"
  }
}
