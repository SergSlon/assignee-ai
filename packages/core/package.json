{
  "name": "@assignee/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic core for Assignee.ai — shared schemas, plugin/pattern/pricing registries, error classes, and AWS credential resolution used by the CLI and MCP server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing/index.js",
      "types": "./dist/testing/index.d.ts"
    },
    "./checkpoint": {
      "import": "./dist/checkpoint/index.js",
      "types": "./dist/checkpoint/index.d.ts"
    },
    "./aws": {
      "import": "./dist/aws/index.js",
      "types": "./dist/aws/index.d.ts"
    },
    "./llm": {
      "import": "./dist/llm/index.js",
      "types": "./dist/llm/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.*",
    "!dist/**/test-fixtures/**",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/assignee-ai/assignee.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/assignee-ai/assignee#readme",
  "bugs": {
    "url": "https://github.com/assignee-ai/assignee/issues"
  },
  "keywords": [
    "assignee",
    "aws",
    "infrastructure",
    "iac",
    "ai",
    "langgraph",
    "cloudcontrol",
    "cloudformation",
    "zod",
    "hexagonal"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.77",
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/google": "^3.0.52",
    "@ai-sdk/openai": "^3.0.47",
    "@aws-sdk/client-cloudcontrol": "^3.1009.0",
    "@aws-sdk/client-cloudformation": "^3.1015.0",
    "@aws-sdk/client-ec2": "^3.1015.0",
    "@aws-sdk/client-rds": "^3.1014.0",
    "@aws-sdk/client-ssm": "^3.1014.0",
    "@clack/prompts": "^1.1.0",
    "@langchain/core": "^1.1.32",
    "ai": "^6.0.116",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@assignee/eslint-config": "workspace:*",
    "@assignee/tsconfig": "workspace:*",
    "@aws-sdk/client-cloudfront": "^3.1014.0",
    "@aws-sdk/client-dynamodb": "^3.1015.0",
    "@aws-sdk/client-efs": "^3.1029.0",
    "@aws-sdk/client-s3": "^3.1014.0",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.2",
    "vitest": "^3.1.0"
  }
}
