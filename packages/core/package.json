{
  "name": "@assignee/core",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic core for Assignee.ai — shared schemas, plugin/pattern/pricing registries, error classes, and AWS credential resolution used by the CLI and MCP server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./checkpoint": {
      "import": "./dist/checkpoint/index.js",
      "types": "./dist/checkpoint/index.d.ts"
    },
    "./llm": {
      "import": "./dist/llm/index.js",
      "types": "./dist/llm/index.d.ts"
    },
    "./graph": {
      "import": "./dist/graph/index.js",
      "types": "./dist/graph/index.d.ts"
    },
    "./test-fixtures/mcp-mock-responses.js": {
      "import": "./dist/test-fixtures/mcp-mock-responses.js",
      "types": "./dist/test-fixtures/mcp-mock-responses.d.ts"
    },
    "./__tests__/fixtures/wizard-matrix-plugins.js": {
      "import": "./dist/__tests__/fixtures/wizard-matrix-plugins.js",
      "types": "./dist/__tests__/fixtures/wizard-matrix-plugins.d.ts"
    },
    "./audit": {
      "import": "./dist/audit/index.js",
      "types": "./dist/audit/index.d.ts"
    },
    "./destroy": {
      "import": "./dist/destroy/index.js",
      "types": "./dist/destroy/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SergSlon/assignee-ai.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/SergSlon/assignee-ai#readme",
  "bugs": {
    "url": "https://github.com/SergSlon/assignee-ai/issues"
  },
  "keywords": [
    "assignee",
    "aws",
    "infrastructure",
    "iac",
    "ai",
    "langgraph",
    "cloudcontrol",
    "cloudformation",
    "zod",
    "hexagonal"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.77",
    "@ai-sdk/anthropic": "^3.0.63",
    "@ai-sdk/google": "^3.0.52",
    "@ai-sdk/openai": "^3.0.47",
    "@assignee/best-practices": "workspace:*",
    "@aws-sdk/client-cloudcontrol": "^3.1044.0",
    "@aws-sdk/client-cloudformation": "^3.1044.0",
    "@aws-sdk/client-ec2": "^3.1044.0",
    "@aws-sdk/client-efs": "^3.1044.0",
    "@aws-sdk/client-eventbridge": "^3.1044.0",
    "@aws-sdk/client-iam": "^3.1044.0",
    "@aws-sdk/client-cloudfront": "^3.1044.0",
    "@aws-sdk/client-dynamodb": "^3.1044.0",
    "@aws-sdk/client-kms": "^3.1044.0",
    "@aws-sdk/client-lambda": "^3.1044.0",
    "@aws-sdk/client-pricing": "^3.1044.0",
    "@aws-sdk/client-rds": "^3.1044.0",
    "@aws-sdk/client-s3": "^3.1044.0",
    "@aws-sdk/client-secrets-manager": "^3.1044.0",
    "@aws-sdk/client-sns": "^3.1044.0",
    "@aws-sdk/client-ssm": "^3.1044.0",
    "@aws-sdk/client-sts": "^3.1044.0",
    "@clack/prompts": "^1.1.0",
    "@langchain/core": "^1.1.32",
    "@langchain/langgraph": "^1.2.2",
    "@langchain/mcp-adapters": "^1.1.3",
    "ai": "^6.0.116",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "yaml": "^2.8.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@assignee/eslint-config": "workspace:*",
    "@assignee/tsconfig": "workspace:*",
    "@types/node": "^25.5.0",
    "eslint": "^9.39.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.1.0"
  }
}
