# Reviewer-skip BAN enforcement (CLAUDE.md §"Reviewer-skip BAN (mandatory)")
# Rejects pushes whose commits lack reviewer evidence in their body.
# Escape hatch: ASSIGNEE_REVIEWER_BAN_BYPASS=1 git push  (logs a warning)
if [ "${ASSIGNEE_REVIEWER_BAN_BYPASS:-0}" = "1" ]; then
  echo "WARNING: ASSIGNEE_REVIEWER_BAN_BYPASS=1 — reviewer-token check skipped." >&2
  exit 0
fi

# ---------------------------------------------------------------------------
# Reviewer token validation helpers
# ---------------------------------------------------------------------------

# Returns 0 if the commit body contains a valid Reviewer token.
# Valid tokens:
#   1. ACCEPT strict:  Reviewer: ACCEPT — <role> (<persona>) — <story_id> — see _archive/reviews/<sha>-review.md
#   2. ACCEPT bootstrap (ONE-TIME only for EPIC-106-1):
#      Reviewer: ACCEPT — bootstrap — EPIC-106-1 — <any-suffix>
#   3. SKIP:           Reviewer: SKIP — <reason> — <user-quote>
# Blocking token (returns non-zero, caller reports it):
#   4. PENDING:        Reviewer: PENDING — ...
#
# Usage: check_reviewer_token "$body" "$short_sha"
check_reviewer_token() {
  _body="$1"
  _sha="$2"

  # SKIP token — always allowed, no evidence file required
  if echo "$_body" | grep -qE "^Reviewer: SKIP — "; then
    return 0
  fi

  # PENDING token — blocking
  if echo "$_body" | grep -qE "^Reviewer: PENDING"; then
    return 2
  fi

  # Bootstrap exception — ONE-TIME for EPIC-106-1 hook-hardening commit only.
  # This literal string is the ONLY bootstrap pattern allowed; it cannot be
  # reused for any other story without changing this hook.
  if echo "$_body" | grep -qF "Reviewer: ACCEPT — bootstrap — EPIC-106-1"; then
    echo "  NOTE: bootstrap exception used for EPIC-106-1 (one-time allowance)" >&2
    return 0
  fi

  # Strict ACCEPT format:
  # Reviewer: ACCEPT — <role> (<persona>) — <story_id> — see _archive/reviews/<sha>-review.md
  _accept_line=$(echo "$_body" | grep -E "^Reviewer: ACCEPT — .+ \(.+\) — [^ ]+ — see _archive/reviews/[a-f0-9]+-review\.md")
  if [ -z "$_accept_line" ]; then
    return 1
  fi

  # Extract the evidence SHA from the line
  _evidence_sha=$(echo "$_accept_line" | sed 's/.*_archive\/reviews\/\([a-f0-9]*\)-review\.md.*/\1/')
  if [ -z "$_evidence_sha" ]; then
    return 1
  fi

  # Verify the evidence file exists in the repo working tree
  _evidence_path="_archive/reviews/${_evidence_sha}-review.md"
  if [ ! -f "$_evidence_path" ]; then
    echo "  REJECT: evidence file missing: ${_evidence_path}" >&2
    return 3
  fi

  # Verify the evidence file's first line matches the required header format:
  # # Reviewer: ACCEPT — <role> (<persona>) — <story_id>
  _first_line=$(head -n 1 "$_evidence_path")
  case "$_first_line" in
    "# Reviewer: ACCEPT — "*)
      # Further validate it contains a parenthesised persona
      if echo "$_first_line" | grep -qE "^# Reviewer: ACCEPT — .+ \(.+\) — [^ ]+"; then
        return 0
      else
        echo "  REJECT: evidence file first line missing parenthesised persona: \"${_evidence_path}\"" >&2
        return 4
      fi
    ;;
    *)
      echo "  REJECT: evidence file has malformed first line (must start with '# Reviewer: ACCEPT — '): \"${_evidence_path}\"" >&2
      return 4
    ;;
  esac
}

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip deletions (push :branch)
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue

  # Tag-push handling (R3-003 fix): a blanket tag exemption was a security
  # regression of MASTER-004 — an operator could `git tag <unreviewed-sha>
  # && git push origin <tag>` to bypass the reviewer-evidence gate. The
  # exemption now fires ONLY when the tagged commit is reachable from
  # origin/<default> (i.e. the commit was previously pushed via a branch
  # and reviewer-checked at that time). Tags pointing to commits not yet
  # on origin/<default> fall through to a single-commit reviewer-evidence
  # check on the tagged SHA itself.
  is_tag_push=0
  case "$local_ref" in
    refs/tags/*)
      default_branch_for_tag=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
      if [ -z "$default_branch_for_tag" ]; then
        for candidate in main master develop trunk; do
          if git rev-parse --verify --quiet "refs/remotes/origin/$candidate" >/dev/null 2>&1; then
            default_branch_for_tag=$candidate
            break
          fi
        done
      fi
      default_branch_for_tag=${default_branch_for_tag:-main}
      if git rev-parse --verify --quiet "refs/remotes/origin/$default_branch_for_tag" >/dev/null 2>&1 \
         && git merge-base --is-ancestor "$local_sha" "refs/remotes/origin/$default_branch_for_tag" >/dev/null 2>&1; then
        # Tagged commit is already on origin/<default> — was reviewer-checked
        # when the branch carrying it was pushed. Safe to exempt.
        continue
      fi
      # Tag points to a commit not yet on origin/<default>. Require
      # reviewer evidence on the tagged commit itself; range is just
      # that single commit.
      range_args="$local_sha~..$local_sha"
      is_tag_push=1
      ;;
  esac

  # New branch (no remote ref) → enumerate commits unique to this branch
  # (i.e. not yet on origin/<default>). Probe origin/HEAD first, then fall
  # back to a fixed candidate list (main/master/develop/trunk) before
  # failing closed. The previous "-n 50" fallback silently exempted
  # commits 51..N on first push of a long branch — soft re-emergence of
  # BH-001. Failing closed forces the operator to fetch the default ref
  # or set ASSIGNEE_REVIEWER_BAN_BYPASS=1 with a justification.
  #
  # Skip this block entirely when range_args was already set by the
  # tag-push case above — otherwise we'd overwrite the single-commit
  # range and silently exempt the unpushed tagged commit.
  if [ "$is_tag_push" = "0" ] && [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    default_remote_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
    if [ -z "$default_remote_branch" ]; then
      for candidate in main master develop trunk; do
        if git rev-parse --verify --quiet "refs/remotes/origin/$candidate" >/dev/null 2>&1; then
          default_remote_branch=$candidate
          break
        fi
      done
    fi
    default_remote_branch=${default_remote_branch:-main}
    if git rev-parse --verify --quiet "refs/remotes/origin/$default_remote_branch" >/dev/null 2>&1; then
      range_args="$local_sha --not refs/remotes/origin/$default_remote_branch"
    else
      echo "" >&2
      echo "Reviewer-skip BAN: cannot determine default-branch ref locally" >&2
      echo "(tried origin/HEAD + origin/{main,master,develop,trunk})." >&2
      echo "" >&2
      echo "Run 'git fetch origin' or 'git remote set-head origin --auto'," >&2
      echo "OR set ASSIGNEE_REVIEWER_BAN_BYPASS=1 with a justification." >&2
      exit 1
    fi
  elif [ "$is_tag_push" = "0" ]; then
    range_args="$remote_sha..$local_sha"
  fi

  # Capture rev-list output AND its exit code separately. set -e does not
  # propagate inside $(...), so a silent failure (force-push made remote_sha
  # unreachable, shallow clone, etc.) would otherwise let the push pass with
  # ZERO commits checked. Fail closed on any rev-list error.
  range_output=$(git rev-list $range_args 2>&1)
  rev_list_exit=$?
  if [ $rev_list_exit -ne 0 ]; then
    echo "" >&2
    echo "Reviewer-skip BAN: failed to enumerate commits in '$range_args' (exit $rev_list_exit):" >&2
    echo "$range_output" >&2
    echo "" >&2
    echo "Cannot verify reviewer evidence — rejecting push to fail closed." >&2
    echo "If this is a legitimate force-push or shallow-clone scenario," >&2
    echo "set ASSIGNEE_REVIEWER_BAN_BYPASS=1 with a justification." >&2
    exit 1
  fi

  failures=""
  for sha in $range_output; do
    # Skip merge commits (multiple parents)
    parent_count=$(git log -1 --format="%P" "$sha" | wc -w | tr -d ' ')
    [ -z "$parent_count" ] && parent_count=1
    [ "$parent_count" -gt 1 ] && continue

    body=$(git log -1 --format="%B" "$sha")
    subject=$(git log -1 --format="%s" "$sha")

    # Use git's portable abbreviated SHA (avoids bash-only ${var:0:N}).
    short_sha=$(git log -1 --format=%h --abbrev=8 "$sha" 2>/dev/null)
    [ -z "$short_sha" ] && short_sha=$(echo "$sha" | cut -c1-8)

    check_reviewer_token "$body" "$short_sha"
    token_result=$?

    case "$token_result" in
      0)
        # Valid token — continue
        ;;
      2)
        # PENDING token — blocking
        failures="${failures}  ${short_sha} '${subject}' [PENDING — review not complete]
"
        ;;
      3)
        # Missing evidence file
        failures="${failures}  ${short_sha} '${subject}' [ACCEPT token missing evidence file]
"
        ;;
      4)
        # Malformed evidence file header
        failures="${failures}  ${short_sha} '${subject}' [ACCEPT token evidence file has malformed header]
"
        ;;
      *)
        # No valid token or unrecognised format
        failures="${failures}  ${short_sha} '${subject}'
"
        ;;
    esac
  done

  if [ -n "$failures" ]; then
    echo "" >&2
    echo "Reviewer-skip BAN (CLAUDE.md): the following commits failed reviewer evidence validation:" >&2
    printf '%s' "$failures" >&2
    echo "" >&2
    echo "For commits with Reviewer: ACCEPT, the required format is:" >&2
    echo "  Reviewer: ACCEPT — <role> (<persona>) — <story_id> — see _archive/reviews/<short-sha>-review.md" >&2
    echo "" >&2
    echo "The cited evidence file must:" >&2
    echo "  1. Exist at _archive/reviews/<short-sha>-review.md" >&2
    echo "  2. Have first line: # Reviewer: ACCEPT — <role> (<persona>) — <story_id>" >&2
    echo "" >&2
    echo "Or use: Reviewer: SKIP — <reason> — <user-confirmation-quote>" >&2
    echo "                  ^         ^" >&2
    echo "                  These are literal em-dashes (U+2014), not hyphens." >&2
    echo "" >&2
    echo "Or set ASSIGNEE_REVIEWER_BAN_BYPASS=1 (emergency only)." >&2
    exit 1
  fi
done
