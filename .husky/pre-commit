pnpm lint-staged

# W10-04 (P064 → L6-F18 + L4-S21): type-check + build gate on every commit.
# Catches TypeScript compile errors before they hit the remote (previously
# only caught in pre-push). Build uses turbo cache so repeat invocations
# on unchanged files are nearly instant (< 2 s typical).
#
# Escape-hatch for parallel-worker commits (feedback_parallel_worker_commit_rhythm):
#   ASSIGNEE_SKIP_BUILD=1 git commit --no-verify  (bypass ONLY for known-good
#   parallel-worker mid-wave commits; full gate runs at wave-close).
# CI does NOT honour --no-verify -- the full suite runs unconditionally.
if [[ "${ASSIGNEE_SKIP_BUILD:-0}" != "1" ]]; then
  pnpm check-types
  pnpm build
fi

# Epic 99 W1b CT-14 defense: reject commits that (re-)introduce the real
# AWS account ID used during dogfood. Replace with the safe synthetic
# ID documented in feedback_no_real_account_ids_in_repo.
#
# Assembled from byte-equivalent fragments so this hook file itself
# doesn't contain the literal 12-digit match target — otherwise a scan
# of the hook finds itself. Fragments join to the real ID at runtime;
# a grep of this source file finds only the fragments, not the ID.
# Robust to empty staged-file list.
_REAL_ID="05""4125""0184""76"
_STAGED_WITH_REAL_ID=$(git diff --cached --name-only 2>/dev/null | xargs grep -l "$_REAL_ID" 2>/dev/null || true)
if [[ -n "$_STAGED_WITH_REAL_ID" ]]; then
  echo "[epic-99/w1b] FATAL: staged files contain the real AWS account ID used during dogfood. Replace with the synthetic ID (see feedback_no_real_account_ids_in_repo)."
  echo "  Offending files:"
  echo "$_STAGED_WITH_REAL_ID" | sed 's/^/    /'
  exit 1
fi

# Epic 96 M1 methodology gate — pre-close probe framework.
#
# When any hot-path source is staged, run the probe manifest against
# the built CLI. The probes are fast (< 30s typical for the touched
# subset) and catch the 6 documented classes of partial-landing that
# Epics 92/94/95 shipped at 25-35% completion rate with.
#
# Hot paths watched:
#   - apps/cli/src/commands/(plan|apply|destroy|list|init|reconcile).ts
#   - packages/core/src/graph/create-graph.ts
#   - packages/core/src/config/help-hints.ts
#   - packages/core/src/graph/nodes/intent-parser.ts
#
# To bypass (emergency only; flag in PR description):
#   ASSIGNEE_SKIP_PRE_CLOSE_PROBES=1 git commit ...
#
# When the dist is missing, skip with a warning — a fresh checkout
# without build shouldn't block commits, but the contract tests still
# run in CI under `pnpm -r test`.
if [[ "${ASSIGNEE_SKIP_PRE_CLOSE_PROBES:-0}" != "1" ]]; then
  HOT_PATHS='^(apps/cli/src/commands/(plan|apply|destroy|list|init|reconcile)\.ts|packages/core/src/graph/create-graph\.ts|packages/core/src/config/help-hints\.ts|packages/core/src/graph/nodes/intent-parser\.ts)$'
  if git diff --cached --name-only --diff-filter=ACMR | grep -Eq "$HOT_PATHS"; then
    if [[ -f apps/cli/dist/index.js ]]; then
      echo "[pre-close-probes] hot-path file staged — running probe gate"
      if ! bash apps/cli/scripts/pre-close-probes.sh; then
        echo "[pre-close-probes] gate failed — see output above. To bypass temporarily:"
        echo "  ASSIGNEE_SKIP_PRE_CLOSE_PROBES=1 git commit ..."
        exit 1
      fi
    else
      echo "[pre-close-probes] apps/cli/dist/index.js missing — skipping (run 'pnpm --filter assignee build' to enable)"
    fi
  fi
fi
